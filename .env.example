# ============================================================
# Foundry — Required Environment Variables
# Copy this file to .env.local for local development.
# Set all of these in Railway dashboard for production.
# ============================================================

# PostgreSQL — Railway provides this automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Set to "true" for Railway/cloud PostgreSQL (auto-enabled in production)
DATABASE_SSL=true

# JWT Secrets — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_64_char_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# App URL — your Railway deployment URL (e.g. https://yourapp.up.railway.app)
NEXT_PUBLIC_APP_URL=https://yourapp.up.railway.app

# Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
INVITE_FROM_EMAIL=noreply@yourdomain.com
INVITE_FROM_NAME=YourAppName

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Social media public base URL
SOCIAL_MEDIA_PUBLIC_BASE_URL=https://yourapp.up.railway.app

# Admin utilities — change or remove after first deployment
ADMIN_CLEANUP_SECRET=change-this-after-deploy
