# ============================================================
# Foundry — Required Environment Variables
# Copy this file to .env.local for local development.
# Set all of these in Railway dashboard for production.
# .env.local is gitignored and NEVER deployed to Railway.
# ============================================================

# PostgreSQL — Railway provides this automatically when you add a Postgres plugin
# Do NOT set this manually in Railway — it is auto-injected as ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/dbname

# SSL — auto-enabled in production. Set "false" to disable explicitly.
DATABASE_SSL=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_64_char_random_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── App URL ───────────────────────────────────────────────────────────────────
# Your Railway deployment URL — used in invitation email links
NEXT_PUBLIC_APP_URL=https://foundry.up.railway.app

# ── Email (Resend) ────────────────────────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
INVITE_FROM_EMAIL=noreply@yourdomain.com
INVITE_FROM_NAME=Foundry

# ── Google OAuth ──────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
# Add https://foundry.up.railway.app/api/auth/google/callback to Authorized redirect URIs
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx

# ── Cloudinary (media uploads) ────────────────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Social Credential Encryption ─────────────────────────────────────────────
# AES-256-GCM key for encrypting stored OAuth credentials in the database.
# Generate with: openssl rand -hex 32
# IMPORTANT: Do NOT change this after social accounts are connected — it will
# invalidate all stored credentials.
SOCIAL_CREDENTIAL_SECRET=replace_with_32_char_random_hex

# ── Social OAuth (optional — only if using social posting features) ───────────
# Facebook & Instagram — https://developers.facebook.com/apps
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_REDIRECT_URI=https://foundry.up.railway.app/api/social/oauth/callback

# LinkedIn — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_REDIRECT_URI=https://foundry.up.railway.app/api/social/oauth/callback

# X (Twitter) — https://developer.twitter.com/en/portal/dashboard
X_CLIENT_ID=your_x_client_id
X_REDIRECT_URI=https://foundry.up.railway.app/api/social/oauth/callback

# YouTube — uses GOOGLE_CLIENT_ID above, just needs the redirect URI
GOOGLE_REDIRECT_URI=https://foundry.up.railway.app/api/social/oauth/callback

# ── Admin ─────────────────────────────────────────────────────────────────────
# Change this after first deployment
ADMIN_CLEANUP_SECRET=change-this-after-deploy
